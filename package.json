{
  "name": "i18next-lazy-keys",
  "version": "0.0.0",
  "description": "Key-level lazy loading for i18next: ship only the translations a render used, fetch the rest on first use.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test:i18next23": "I18NEXT_VERSION=23 vitest run",
    "test:all": "pnpm test && pnpm test:i18next23"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jyunhanlin/i18next-lazy-keys.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "i18next",
    "i18n",
    "ssr",
    "lazy-loading",
    "tree-shaking",
    "postprocessor",
    "plugin"
  ],
  "peerDependencies": {
    "i18next": ">=23",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "i18next": "^26.4.0",
    "i18next-v23": "npm:i18next@23.10.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
